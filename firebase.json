{
  "functions": [
    {
      "codebase": "default",
      "source": "backend/functions",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix ./backend/functions run build"
      ]
    }
  ],
  "firestore": {
    "rules": "backend/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "backend/storage.rules"
  },
  "hosting": {
    "public": "frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}