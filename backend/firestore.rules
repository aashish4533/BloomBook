rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    // Check if the user has the 'admin' role in their user document
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());

      match /paymentMethods/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /payoutDetails/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Books ---
    // 1. Books: Anyone can read, only logged in users can write
    match /books/{bookId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    // --- Communities ---
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Admin can update any field. Members can only update membership fields (join/leave).
      allow update: if isAuthenticated() && (
        // Rule 1: Community admin has full update access
        resource.data.adminId == request.auth.uid ||
        // Rule 2: Any authenticated user can update ONLY membership-related fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'pending', 'memberCount'])
      );
      allow delete: if isAuthenticated() && resource.data.adminId == request.auth.uid;

      match /members/{memberId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.auth.uid == memberId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid);
        allow delete: if isAuthenticated() && (request.auth.uid == memberId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid || isAdmin());
      }

      match /pending/{userId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid);
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && (request.auth.uid == userId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid);
      }

      // Subcollection for Group Chat messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        
        // Community Equilibrium: Anti-Impersonation & Membership Validation
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
                      request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;

        // Reaction Subcollections
        match /reactions/{userId} {
          allow read: if isAuthenticated() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
          allow write: if false; 
        }
      }
      match /posts/{postId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

        match /comments/{commentId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

          match /replies/{replyId} {
            allow read: if true;
            allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
            allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
          }
        }

        // One reaction per user — document ID must equal the user's own UID
        match /reactions/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    // --- Global Posts ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
        }
      }
    }

    match /negotiations/{negotiationId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if false; // Only via Cloud Function payments trigger
      allow update: if false; // Only via Cloud Function manual proof verification
    }

    // --- Purchases ---
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow write: if false; // Only via Cloud Function payments webhook
    }

    // --- Sales ---
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false; // Only via Cloud Function payments webhook
    }


    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    
    // 2. Chats: Users can create chats and read/update chats they are part of
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // 3. Orders/Purchases: Users can only read their own purchase history
    match /orders/{orderId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // --- Rentals ---
    match /rentals/{rentalId} {
      allow read: if isAuthenticated() && (resource.data.renterId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if false; // Only via Cloud Function payments webhook
    }

    // --- Notes (Helping Material) ---
    match /notes/{noteId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Allow update/delete if user email matches uploadedBy OR if user is admin
      allow update, delete: if isAuthenticated() && (
        request.auth.token.email == resource.data.uploadedBy || 
        isAdmin()
      );

      // Comments subcollection for notes
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        // Allow author to delete/edit their own comment or admin
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }
    
    // --- Wishlists ---
    match /wishlists/{wishlistId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- Verification System ---
    match /verifications/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false; // Only via Cloud Functions
    }

    match /skillTests/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false; // Only via Cloud Functions
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false; // Only via Cloud Functions
    }

    // --- Helper for Tutor Verification ---
    function isVerifiedTutor() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/tutors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tutors/$(request.auth.uid)).data.verificationStatus == 'Verified';
    }

    // --- Tuition Requests ---
    match /tuition_requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      // Orbital Oversight: Manual Override for Admins
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);

      // --- Bids Sub-collection ---
      match /bids/{tutorId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/tuition_requests/$(requestId)).data.studentId == request.auth.uid ||
          request.auth.uid == tutorId
        );
        allow create: if isVerifiedTutor() && request.auth.uid == tutorId && 
                      (!('orbit_status' in get(/databases/$(database)/documents/tuition_requests/$(requestId)).data) || 
                       get(/databases/$(database)/documents/tuition_requests/$(requestId)).data.orbit_status == 'Open');
        allow delete: if isAuthenticated() && request.auth.uid == tutorId;
      }
    }

    match /tutors/{tutorId} {
      allow read: if true;
      // Allow creation only as Pending
      allow create: if isAuthenticated() && (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'Pending');
      
      // Orbital Oversight: Manual Override for Admins
      allow update: if isAuthenticated() && (request.auth.uid == tutorId || isAdmin()) && 
                    (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == resource.data.verificationStatus || isAdmin());
      allow delete: if isAdmin();
    }

    // --- The Cognitive Shield (AI Assistant Security) ---
    match /ai_assistant_chats/{chatId} {
      // Isolate Conversations
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Rate Control (Block generic creates, limit via functions/timestamps if needed)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // --- Neural Privacy ---
    match /neural_vault/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}