rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    // Check if the user has the 'admin' role in their user document
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Community member: subcollection doc (preferred) or legacy members array on community doc
    function isCommunityMember(communityId) {
      return exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
        || request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.get('members', []);
    }

    function isCommunityAdminOnly(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid;
    }

    // Buyer local-pickup hold: only reservation fields, seller userId unchanged, listing not sold / held by others.
    function buyerPlacesReservationOnBook() {
      let ownerId = resource.data.get('userId', '');
      let prevStatus = resource.data.get('listingStatus', '');
      let prevReservedBy = resource.data.get('reservedBy', '');
      return isAuthenticated()
        && ownerId != ''
        && ownerId != request.auth.uid
        && request.resource.data.get('userId', '') == ownerId
        && resource.data.get('isSold', false) != true
        && resource.data.get('listingStatus', '') != 'sold'
        && !(prevStatus == 'reserved' && prevReservedBy != '' && prevReservedBy != request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['listingStatus', 'reservedBy', 'reservedUntil', 'reservationPurchaseId', 'updatedAt'])
        && request.resource.data.get('listingStatus', '') == 'reserved'
        && request.resource.data.get('reservedBy', '') == request.auth.uid;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());

      match /paymentMethods/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /payoutDetails/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Self-notifications OK; cross-user only if sourceUid proves the writer is the authenticated user (anti-spoof).
      allow create: if isAuthenticated()
        && (
          request.resource.data.userId == request.auth.uid
          || (
            request.resource.data.userId != request.auth.uid
            && request.resource.data.get('sourceUid', '') == request.auth.uid
          )
        );
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Books ---
    // 1. Books: Anyone can read, only logged in users can write
    match /books/{bookId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.get('userId', '') == request.auth.uid)
        || buyerPlacesReservationOnBook();
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.get('userId', '') == request.auth.uid);
    }

    // --- Communities ---
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Admin can update any field. Members can only update membership fields (join/leave).
      allow update: if isAuthenticated() && (
        // Rule 1: Community admin has full update access
        resource.data.adminId == request.auth.uid ||
        // Rule 2: Members (or community admin) may bump post count when creating/deleting posts
        (
          (isCommunityMember(communityId) || isCommunityAdminOnly(communityId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postsCount'])
        ) ||
        // Rule 3: Any authenticated user can update ONLY membership-related fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'pending', 'memberCount'])
      );
      allow delete: if isAuthenticated() && resource.data.adminId == request.auth.uid;

      match /members/{memberId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.auth.uid == memberId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid);
        allow delete: if isAuthenticated() && (request.auth.uid == memberId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid || isAdmin());
      }

      match /pending/{userId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid);
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && (request.auth.uid == userId || get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid);
      }

      // Subcollection for Group Chat messages (same membership as posts / GroupChat UI: subdoc OR parent members[] OR admin)
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isCommunityAdminOnly(communityId) || isCommunityMember(communityId)
        );

        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && (isCommunityAdminOnly(communityId) || isCommunityMember(communityId));
        allow update, delete: if false;

        match /reactions/{userId} {
          allow read: if isAuthenticated() && (
            isCommunityAdminOnly(communityId) || isCommunityMember(communityId)
          );
          allow write: if false;
        }
      }
      match /posts/{postId} {
        allow read: if true;
        // App writes authorId (not userId). Members may react / comment (patch reactions, commentCount, userReaction).
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && (isCommunityMember(communityId) || isCommunityAdminOnly(communityId));
        allow update: if isAuthenticated() && (
          isAdmin() ||
          isCommunityAdminOnly(communityId) ||
          resource.data.authorId == request.auth.uid ||
          (
            isCommunityMember(communityId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions', 'commentCount', 'userReaction'])
          )
        );
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

        match /comments/{commentId} {
          allow read: if true;
          allow create: if isAuthenticated()
            && request.resource.data.authorId == request.auth.uid
            && (isCommunityMember(communityId) || isCommunityAdminOnly(communityId));
          allow update: if isAuthenticated() && (
            isAdmin() ||
            isCommunityAdminOnly(communityId) ||
            resource.data.authorId == request.auth.uid ||
            (
              isCommunityMember(communityId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'userLiked'])
            )
          );
          allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

          match /replies/{replyId} {
            allow read: if true;
            allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
            allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
          }
        }

        // One reaction per user — document ID must equal the user's own UID
        match /reactions/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    // --- Global Posts ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
        }
      }
    }

    // --- Book exchanges (peer-to-peer swap offers) ---
    match /exchanges/{exchangeId} {
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && exists(/databases/$(database)/documents/books/$(request.resource.data.requestedBookId))
        && get(/databases/$(database)/documents/books/$(request.resource.data.requestedBookId)).data.get('userId', '') == request.resource.data.ownerId
        && exists(/databases/$(database)/documents/books/$(request.resource.data.offeredBookId))
        && get(/databases/$(database)/documents/books/$(request.resource.data.offeredBookId)).data.get('userId', '') == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /negotiations/{negotiationId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid
      );
      allow update: if isAdmin();
    }

    // --- Purchases ---
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      // Local pickup reservations are created/updated from the client (no card payment in this flow).
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.buyerId == request.auth.uid;
      allow delete: if false;
    }

    // --- Sales ---
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false; // Only via Cloud Function payments webhook
    }


    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    
    // 2. Chats: Users can create chats and read/update chats they are part of
    match /chats/{chatId} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.get('participants', []);
      // Read if participant, or doc has no participants yet (repair path after setDoc merge)
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.get('participants', [])
        || resource.data.get('participants', []).size() == 0
      );
      // Update if already a participant, or participants missing/empty and this update sets a valid pair including the user
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.get('participants', [])
        || (
          resource.data.get('participants', []).size() == 0
          && request.auth.uid in request.resource.data.get('participants', [])
          && request.resource.data.get('participants', []).size() >= 2
        )
      );
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []);

        match /reactions/{reactorId} {
          allow read: if request.auth != null
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []);
          allow create, update: if request.auth != null
            && request.auth.uid == reactorId
            && exists(/databases/$(database)/documents/chats/$(chatId))
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []);
          allow delete: if request.auth != null && request.auth.uid == reactorId;
        }
      }
    }

    // 3. Cart / legacy orders (CartDrawer)
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // --- Rentals ---
    match /rentals/{rentalId} {
      allow read: if isAuthenticated() && (
        resource.data.renterId == request.auth.uid ||
        resource.data.lenderId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.renterId == request.auth.uid
        && request.resource.data.lenderId == get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.userId
        && request.resource.data.status == 'reserved_rent';
      allow update: if isAuthenticated() && (
        resource.data.renterId == request.auth.uid ||
        resource.data.lenderId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // --- Notes (Helping Material) ---
    match /notes/{noteId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.auth.token.email != null
        && request.resource.data.get('uploadedBy', '') == request.auth.token.email;
      // Allow update/delete if user email matches uploadedBy OR if user is admin
      allow update, delete: if isAuthenticated() && (
        request.auth.token.email == resource.data.uploadedBy || 
        isAdmin()
      );

      // Comments subcollection for notes
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.get('userId', '') == request.auth.uid;
        // Allow author to delete/edit their own comment or admin
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    // --- Notes hub: community material requests (books, notes, other) ---
    match /material_requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
    
    // --- Wishlists ---
    match /wishlists/{wishlistId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- Verification System ---
    match /verifications/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false; // Only via Cloud Functions
    }

    match /skillTests/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false; // Only via Cloud Functions
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false; // Only via Cloud Functions
    }

    // --- Helper for Tutor Verification ---
    function isVerifiedTutor() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/tutors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tutors/$(request.auth.uid)).data.verificationStatus == 'Verified';
    }

    function isTuitionStudentVerified() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentVerificationStatus', 'unverified') == 'verified';
    }

    // Written tuition deal (proposal/accept via Cloud Functions; clients read only)
    match /tuition_agreements/{chatId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // --- Tuition Requests ---
    match /tuition_requests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.studentId == request.auth.uid
                    && isTuitionStudentVerified();
      // Orbital Oversight: Manual Override for Admins
      allow update: if isAdmin()
                    || (isAuthenticated() && resource.data.studentId == request.auth.uid && isTuitionStudentVerified())
                    || (
                      isVerifiedTutor()
                      && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                        'orbit_status',
                        'status',
                        'assignedTutorId',
                        'assignedTutorName',
                        'updatedAt'
                      ])
                      && (!('orbit_status' in resource.data) || resource.data.orbit_status == 'Open')
                      && (!('assignedTutorId' in resource.data) || resource.data.assignedTutorId == null || resource.data.assignedTutorId == '')
                      && request.resource.data.orbit_status == 'Assigned'
                      && request.resource.data.status == 'accepted'
                      && request.resource.data.assignedTutorId == request.auth.uid
                    );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);

      // --- Bids Sub-collection ---
      match /bids/{tutorId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/tuition_requests/$(requestId)).data.studentId == request.auth.uid ||
          request.auth.uid == tutorId
        );
        allow create: if isVerifiedTutor() && request.auth.uid == tutorId && 
                      (!('orbit_status' in get(/databases/$(database)/documents/tuition_requests/$(requestId)).data) || 
                       get(/databases/$(database)/documents/tuition_requests/$(requestId)).data.orbit_status == 'Open');
        allow delete: if isAuthenticated() && request.auth.uid == tutorId;
      }
    }

    match /tutors/{tutorId} {
      allow read: if true;
      // Allow creation only as Pending
      allow create: if isAuthenticated() && (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'Pending');
      
      // Updates: unchanged status, admin, or tutor fixing profile while not verified (legacy docs missing verificationStatus, or Reviewing/Rejected → Pending from portal)
      allow update: if isAuthenticated() && (request.auth.uid == tutorId || isAdmin()) && (
        isAdmin()
        || request.resource.data.verificationStatus == resource.data.get('verificationStatus', null)
        || (
          request.auth.uid == tutorId
          && request.resource.data.verificationStatus == 'Pending'
          && resource.data.get('verified', false) != true
          && (
            !('verificationStatus' in resource.data)
            || resource.data.verificationStatus == 'Pending'
            || resource.data.verificationStatus == 'Rejected'
            || resource.data.verificationStatus == 'Reviewing'
            || resource.data.verificationStatus == 'Revoked'
          )
        )
      );
      allow delete: if isAdmin();
    }

    // --- The Cognitive Shield (AI Assistant Security) ---
    match /ai_assistant_chats/{chatId} {
      // Isolate Conversations
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Rate Control (Block generic creates, limit via functions/timestamps if needed)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // --- Neural Privacy ---
    match /neural_vault/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}