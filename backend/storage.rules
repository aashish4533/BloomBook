rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Restrict verification bucket to specific user
    match /verification/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow read access to all OTHER files (e.g. public avatars/covers)
    match /{allPaths=**} {
      allow read: if true;
      // Allow general writes if authenticated
      allow write: if request.auth != null;
    }
  }
}
