rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Match Firestore user role (same idea as firestore.rules isAdmin for uploads)
    function isStorageAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Is the file an image and under 5MB?
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024 
             && request.resource.contentType.matches('image/.*');
    }

    // Helper: Allow common note/document uploads up to 25MB.
    function isAllowedNotesFile() {
      return request.resource.size < 25 * 1024 * 1024
             && (
               request.resource.contentType.matches('application/pdf')
               || request.resource.contentType.matches('application/msword')
               || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
               || request.resource.contentType.matches('application/vnd.ms-powerpoint')
               || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.presentationml.presentation')
               || request.resource.contentType.matches('text/plain')
               || request.resource.contentType.matches('image/.*')
             );
    }

    // Book listing images: book_images/{uid}/{fileName} (GiveBooksOnRent, SellBookFlow, ExchangeBookFlow)
    match /book_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUnder5MB();
    }

    // Legacy book images: book_images/{fileName} (older single-segment paths — still need public read)
    match /book_images/{legacyFile} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-added inventory images: book_images/admin/{fileName}
    match /book_images/admin/{fileName} {
      allow read: if true;
      allow write: if isStorageAdmin() && isImageUnder5MB();
    }

    // Community Covers
    match /community_covers/{communityId} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageUnder5MB();
    }

    // Community chat images: chat_attachments/{communityId}/{fileName} (GroupChat.tsx)
    match /chat_attachments/{communityId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImageUnder5MB();
    }

    // Post images (CreatePost.tsx): post_images/{fileName}
    match /post_images/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageUnder5MB();
    }

    // Tutor Verification Documents
    match /verifications/{userId}/{docId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUnder5MB();
    }

    // Notes / Helping Material uploads
    match /helping-material/{userEmail}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.auth.token.email == userEmail
                   && isAllowedNotesFile();
    }
  }
}
