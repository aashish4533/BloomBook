rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is the file an image and under 5MB?
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024 
             && request.resource.contentType.matches('image/.*');
    }

    // Book Images
    match /book_images/{imageId} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageUnder5MB();
    }

    // Community Covers
    match /community_covers/{communityId} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageUnder5MB();
    }

    // Chat Attachments
    match /chat_attachments/{messageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImageUnder5MB();
    }

    // Tutor Verification Documents
    match /verifications/{userId}/{docId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUnder5MB();
    }
  }
}
