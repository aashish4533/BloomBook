rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helpers
    function isAdmin() {
      return request.auth != null && 
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Neural Vault: Restrict verification buckets to specific user & Admins (Lockdown list operation)
    match /verifications/{userId}/{allPaths=**} {
      allow read, list: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /verification/{userId}/{allPaths=**} {
      allow read, list: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow read access to all OTHER files (e.g. public avatars/covers)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                   request.resource.size < 5 * 1024 * 1024 && 
                   request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
